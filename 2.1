public class SinglyApp {

    public static void main(String[] args) {

        SinglyLinkedList list1 = new SinglyLinkedList();

        list1.append(101);
        list1.append(102);
        list1.append(103);

        System.out.println("Test method 'append()'");
        list1.append(104);
        list1.append(105);

        System.out.println("Current List => " + list1);

        System.out.println();

        System.out.println("Test method 'get()'");

        int i = 2;
        int j = 7;

        Object data1 = list1.get(i);
        Object data2 = list1.get(j);

        System.out.println("Get element index " + i + " = "
                + (data1 == null ? "No data" : data1));

        System.out.println("Get element index " + j + " = "
                + (data2 == null ? "No data" : data2));

        System.out.println();

        System.out.println("Test method 'set()'");

        list1.set(2, 111);
        System.out.println("Current List => " + list1);

        list1.set(7, 222);
        System.out.println("Current List => " + list1);

        System.out.println();

        System.out.println("Test method 'contains()'");

        int find1 = 104;
        int find2 = 222;

        if (list1.contains(find1)) {
            System.out.println(find1 + " found!!");
        } else {
            System.out.println(find1 + " not found...");
        }

        if (list1.contains(find2)) {
            System.out.println(find2 + " found!!");
        } else {
            System.out.println(find2 + " not found...");
        }

        System.out.println();

        System.out.println("Test method 'addAll()'");

        SinglyLinkedList list2 = new SinglyLinkedList();

        list1.addAll(list2);

        System.out.println("Elements in list1 => " + list1);
        System.out.println("Elements in list2 => " + list2);
        System.out.println("Merge result => " + list1);

        list2.append(201);
        list2.append(202);
        list2.append(203);
        list2.append(204);
        list2.append(205);

        System.out.println();
        System.out.println("Elements in list1 => " + list1);
        System.out.println("Elements in list2 => " + list2);

        list1.addAll(list2);

        System.out.println("Merge result => " + list1);
    }
}
